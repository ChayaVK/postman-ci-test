// Jenkins declarative pipeline for the practice API suite.
// Agent needs: Node.js 18+ and curl. Plugins: JUnit, HTML Publisher.
pipeline {
  agent any
  options { timeout(time: 15, unit: 'MINUTES') }
  triggers { cron('H 2 * * *') }   // nightly run, between 02:00 and 02:59

  stages {
    stage('Install Newman') {
      steps {
        sh '''
          npm install --prefix .newman \
            newman@6.2.3 newman-reporter-htmlextra@1.23.1
        '''
      }
    }
    stage('API tests') {
      steps {
        // One sh step: Jenkins stops background processes when a step ends,
        // so the API must start, be tested and stop inside the same step.
        sh '''
          cd practice-api
          node server.js > ../api.log 2>&1 &
          API_PID=$!
          cd ..
          for i in $(seq 1 30); do
            curl -sf http://localhost:3000/health > /dev/null && break
            if [ "$i" -eq 30 ]; then cat api.log; kill $API_PID; exit 1; fi
            sleep 1
          done
          set +e
          .newman/node_modules/.bin/newman run \
            collections/ch27-newman-suite.postman_collection.json \
            -e collections/local.postman_environment.json \
            -r cli,junit,htmlextra --color off \
            --reporter-junit-export reports/junit.xml \
            --reporter-htmlextra-export reports/api-report.html
          RESULT=$?
          kill $API_PID
          exit $RESULT
        '''
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: 'reports/junit.xml'
      publishHTML(target: [reportName: 'API Test Report', reportDir: 'reports',
                           reportFiles: 'api-report.html', keepAll: true,
                           alwaysLinkToLastBuild: true, allowMissing: true])
      archiveArtifacts artifacts: 'reports/**, api.log', allowEmptyArchive: true
    }
  }
}
