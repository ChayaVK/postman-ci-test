						"description": "Reads the product whose id is in `productId`."
					},
					"response": []
				}
			]
		},
		{
			"name": "Reports",
			"description": "The sales report needs an API key. The key is set once, on this folder (Authorization tab: API Key, `x-api-key`, `{{apiKey}}`), and every request in the folder inherits it.",
			"item": [
				{
					"name": "Sales report",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/reports/sales",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"reports",
								"sales"
							]
						},
						"description": "Inherits the API key from the folder."
					},
					"response": []
				},
				{
					"name": "Sales report without the key (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/reports/sales",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"reports",
								"sales"
							]
						},
						"auth": {
							"type": "noauth"
						},
						"description": "This request overrides the folder with **No Auth**, so the API answers `401`."
					},
					"response": []
