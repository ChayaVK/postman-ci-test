		{
			"name": "Products",
			"description": "Product catalog. No login needed.",
			"item": [
				{
					"name": "List electronics in stock",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/products?category=electronics&inStock=true",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products"
							],
							"query": [
								{
									"key": "category",
