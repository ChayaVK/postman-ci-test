{
  "info": {
    "_postman_id": "8b81b2a3-a908-5fd5-b0bd-476f886c2d6e",
    "name": "Ch30 Healthy Suite",
    "description": "# Ch30 Healthy Suite\n\nA small suite that follows the rules from Chapter 30:\n\n- Folders in run order: `00 Setup`, feature folders, `99 Cleanup`.\n- Request names say what is checked. Test names say what must be true.\n- Common checks live once, in the collection-level post-response script.\n- Every run creates its own data (unique email) and deletes it at the end, so the suite can run twice in a row, or next to a teammate's run, without failing.\n- Assertions are relative (\"the list contains my user\"), never absolute (\"there are 8 users\").",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Setup",
      "description": "Everything the other folders need: here, only a token.",
      "item": [
        {
          "name": "Log in as tester",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login works', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create a user with unique data",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique data for THIS run: no clash with earlier runs or with a teammate's run",
                  "const runId = Date.now().toString(36) + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set('userName', 'Suite User ' + runId);",
                  "pm.collectionVariables.set('userEmail', `suite.${runId}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"role\": \"tester\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Search finds the new user (relative check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = pm.response.json().data.map(u => u.id);",
                  "pm.test('The list contains the user this run created', () => {",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?search={{userName}}&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "{{userName}}"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place an order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order placed', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 4,\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel the order (puts the stock back)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order cancelled', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('CANCELLED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "99 Cleanup",
      "description": "Deletes what the run created. Runs last, and runs even when earlier tests failed.",
      "item": [
        {
          "name": "Delete the user this run created",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "The user is gone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 after delete', () => pm.response.to.have.status(404));",
                  "// leave nothing behind for the next run",
                  "['token', 'userId', 'userName', 'userEmail', 'orderId']",
                  "  .forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level post-response script: runs after EVERY request.",
          "const budget = Number(pm.collectionVariables.get('responseBudgetMs'));",
          "pm.test(`[common] answered within ${budget} ms`, () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(budget);",
          "});",
          "pm.test('[common] has an X-Request-Id header', () => {",
          "  pm.response.to.have.header('X-Request-Id');",
          "});",
          "if (pm.response.code >= 400) {",
          "  pm.test('[common] error body uses the standard format', () => {",
          "    const body = pm.response.json();",
          "    pm.expect(body.error.code).to.be.a('string');",
          "    pm.expect(body.error.message).to.be.a('string');",
          "    pm.expect(body.requestId).to.be.a('string');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "responseBudgetMs",
      "value": "1000",
      "type": "string"
    }
  ]
}
