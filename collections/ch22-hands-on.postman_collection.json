    {
      "name": "04 POST /api/reports",
      "item": [
        {
          "name": "POST /api/reports",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reports",
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"sales\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('job', pm.response.json().jobId);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "GET /api/jobs/{{job}}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/jobs/{{job}}"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "GET /api/jobs/{{job}} (2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/jobs/{{job}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// wait 3 s before sending, so the job has moved on",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
