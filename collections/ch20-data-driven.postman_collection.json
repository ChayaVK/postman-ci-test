{
  "info": {
    "_postman_id": "478199dd-2192-5bf5-b453-954e721aee67",
    "name": "Ch 20 - Data-Driven Testing",
    "description": "Chapter 20 of the QAMadeEasy course. One request, many test cases: each row of the data file is one iteration with its own input and its own expected status. Run ONE folder with its matching data file (CSV folder + ch20-users.csv, JSON folder + ch20-users.json).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CSV: create users",
      "description": "Run with the data file project/data/ch20-users.csv (Newman: --folder \"CSV: create users\" -d project/data/ch20-users.csv).",
      "item": [
        {
          "name": "Reset practice data (first row only)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reset once, before the first row only: every later row skips this request",
                  "if (pm.info.iteration > 0) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Practice data reset', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reset"
              ]
            },
            "description": "Puts the practice data back so the rows give the same result on every run. Skipped for every row after the first."
          },
          "response": []
        },
        {
          "name": "Create a user from the CSV row",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const row = pm.iterationData;                        // the current CSV row",
                  "const expected = Number(row.get('expectedStatus'));  // CSV values are text",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(`${row.get('case')}: status ${expected}`, function () {",
                  "  pm.response.to.have.status(expected);",
                  "});",
                  "",
                  "if (expected === 201) {",
                  "  pm.test(`${row.get('case')}: user saved as sent`, function () {",
                  "    pm.expect(body.name).to.eql(row.get('name'));",
                  "    pm.expect(body.email).to.eql(row.get('email'));",
                  "    pm.expect(body.role).to.eql(row.get('role'));",
                  "  });",
                  "} else {",
                  "  pm.test(`${row.get('case')}: error ${row.get('expectedCode')}`, function () {",
                  "    pm.expect(body.error.code).to.eql(row.get('expectedCode'));",
                  "    if (row.get('expectedField')) {",
                  "      const fields = body.error.details.map(d => d.field);",
                  "      pm.expect(fields).to.include(row.get('expectedField'));",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"role\": \"{{role}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "{{name}}, {{email}} and {{role}} come from the current row of the data file."
          },
          "response": []
        }
      ]
    },
    {
      "name": "JSON: create users",
      "description": "Run with the data file project/data/ch20-users.json (Newman: --folder \"JSON: create users\" -d project/data/ch20-users.json).",
      "item": [
        {
          "name": "Reset practice data (first row only)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reset once, before the first row only: every later row skips this request",
                  "if (pm.info.iteration > 0) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Practice data reset', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reset"
              ]
            },
            "description": "Puts the practice data back so the rows give the same result on every run. Skipped for every row after the first."
          },
          "response": []
        },
        {
          "name": "Create a user from the JSON row",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The row's \"body\" is a real JSON object: turn it into the request body",
                  "pm.variables.set('userBody', JSON.stringify(pm.iterationData.get('body')));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const row = pm.iterationData.toObject();   // the whole JSON row as an object",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(`${row.case}: status ${row.expectedStatus}`, function () {",
                  "  pm.response.to.have.status(row.expectedStatus);   // already a number",
                  "});",
                  "",
                  "if (row.expect) {",
                  "  pm.test(`${row.case}: saved values`, function () {",
                  "    Object.keys(row.expect).forEach(function (key) {",
                  "      pm.expect(body[key], key).to.eql(row.expect[key]);",
                  "    });",
                  "  });",
                  "}",
                  "",
                  "if (row.expectedField) {",
                  "  pm.test(`${row.case}: error names ${row.expectedField}`, function () {",
                  "    const fields = body.error.details.map(d => d.field);",
                  "    pm.expect(fields).to.include(row.expectedField);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{userBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The body is the row's \"body\" object, so rows can send booleans or leave fields out."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": []
}
