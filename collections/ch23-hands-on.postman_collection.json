{
  "info": {
    "name": "Ch 23 API Security Testing (hands-on)",
    "description": "Every request you send in Chapter 23, in the order of the chapter. Select the environment \"Practice API - Local\" first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 GET /health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "02 GET /api/orders/1002",
      "item": [
        {
          "name": "Log in as tester",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"tester\", \"password\": \"Test@123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/orders/1002",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/1002"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "GET /api/insecure/orders/1002",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/insecure/orders/1002"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "03 POST /api/insecure/register",
      "item": [
        {
          "name": "POST /api/insecure/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/insecure/register",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"qa.mass.1\",\"password\":\"Pass@1234\",\"role\":\"admin\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"qa.mass.1\",\"password\":\"Pass@1234\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "04 GET /api/insecure/search?q=t",
      "item": [
        {
          "name": "GET /api/insecure/search?q=t",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/insecure/search?q=t"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ]
}
