						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"me"
					]
				},
				"description": "Inherits the Bearer token from the collection."
			},
			"response": []
		},
		{
			"name": "My orders",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/orders",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"orders"
					]
				},
				"description": "Inherits the Bearer token from the collection."
			},
