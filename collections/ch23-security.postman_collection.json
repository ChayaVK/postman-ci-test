        {
          "name": "Users expose no secrets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Allow-list: the ONLY fields a user record may expose",
                  "const allowed = ['id', 'name', 'email', 'role', 'active', 'createdAt',",
                  "  'updatedAt'];",
                  "",
                  "pm.test('Every user exposes only allowed fields', function () {",
                  "  pm.response.json().data.forEach(function (u) {",
                  "    Object.keys(u).forEach(function (k) {",
                  "      pm.expect(allowed, `field \"${k}\" of user ${u.id}`).to.include(k);",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Extra fields are ignored",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('massEmail', `mass.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.response.json();",
                  "",
                  "pm.test('User created (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Client could not choose its own id', function () {",
                  "  pm.expect(user.id).to.not.eql(1);",
                  "});",
                  "",
                  "pm.test('Unknown field isAdmin was ignored', function () {",
                  "  pm.expect(user).to.not.have.property('isAdmin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
