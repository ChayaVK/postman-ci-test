    "name": "Ch 23 - API Security Tests",
    "description": "Chapter 23 of the QAMadeEasy course. Defensive security tests against the NORMAL (secure) endpoints of the practice API. Every test passes. Only run security tests against systems you own or have written permission to test. A full run takes about 15 seconds (the expired-token test waits 11 seconds).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Authentication (API2)",
      "description": "Missing, broken, edited and expired tokens must all be refused; login errors must not help an attacker.",
      "item": [
        {
          "name": "Log in as tester",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login works (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "No token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No token: 401 UNAUTHORIZED', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED');",
                  "});",
                  "",
                  "pm.test('401 says how to authenticate (WWW-Authenticate)', function () {",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer');",
                  "});",
                  "",
                  "pm.test('No order data in the body', function () {",
                  "  pm.expect(pm.response.json()).to.not.have.property('data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Garbage token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A random string as token: 401 INVALID_TOKEN', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('INVALID_TOKEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-real-token",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Tampered token (role changed)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Take the real token, change \"role\" to admin, keep the old signature",
                  "const token = pm.collectionVariables.get('token');",
                  "const [header, payload, signature] = token.split('.');",
                  "const claims = JSON.parse(Buffer.from(payload, 'base64').toString());",
                  "claims.role = 'admin';",
                  "const edited = Buffer.from(JSON.stringify(claims)).toString('base64')",
                  "  .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('tamperedToken',",
                  "  [header, edited, signature].join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Edited token is rejected: signature check (401)', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('INVALID_TOKEN');",
                  "  pm.expect(pm.response.json().error.message).to.include('signature');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Negative test: the real token with one claim changed in the payload. The server must refuse it (401, signature check). Why this works: Chapter 7.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tamperedToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Expired token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Get a token that lives 10 seconds, then wait 11 seconds",
                  "// (skipped when an expired token is already stored)",
                  "if (!pm.collectionVariables.get('shortToken')) {",
                  "  pm.sendRequest({",
                  "    url: pm.variables.replaceIn('{{baseUrl}}/api/auth/login'),",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({",
                  "      username: pm.variables.get('username'),",
                  "      password: pm.variables.get('password'),",
                  "      expiresIn: 10 }) }",
                  "  }, function (err, res) {",
                  "    pm.collectionVariables.set('shortToken', res.json().token);",
                  "    setTimeout(function () {}, 11000);",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expired token is rejected: 401 TOKEN_EXPIRED', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('TOKEN_EXPIRED');",
                  "});",
                  "pm.collectionVariables.unset('shortToken');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{shortToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const msg = pm.response.json().error.message;",
                  "",
                  "pm.test('Wrong password: 401 INVALID_CREDENTIALS', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS');",
                  "});",
                  "",
                  "pm.test('Message does not say WHICH part was wrong', function () {",
                  "  pm.expect(msg).to.eql('Username or password is wrong.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Unknown user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown user gets the very same answer', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.message)",
                  "    .to.eql('Username or password is wrong.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nobody\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ],
      "auth": {
        "type": "noauth"
      }
