{
  "info": {
    "_postman_id": "2d34f3f4-fb43-5d33-b978-4b088eb04fef",
    "name": "Ch 19 - Chaining Requests",
    "description": "Chapter 19 of the QAMadeEasy course. Two flows where each request uses values saved by the previous one (collection variables). Run the whole collection, or one folder, in order; every test passes and the clean-up steps leave the data as they found it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 User lifecycle",
      "description": "Create -> read -> update -> verify -> delete -> verify 404. Each request uses values saved by the one before it. Run the folder in order.",
      "item": [
        {
          "name": "Create a user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh test data for this run: a unique email (Chapter 14)",
                  "pm.collectionVariables.set('userName', 'Chain Test User');",
                  "pm.collectionVariables.set('userEmail', `chain.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User is created (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code !== 201) {",
                  "  // Nothing to chain: stop the run instead of failing 5 more requests",
                  "  pm.execution.setNextRequest(null);",
                  "  return;",
                  "}",
                  "",
                  "const user = pm.response.json();",
                  "pm.collectionVariables.set('userId', user.id);            // from the body",
                  "pm.collectionVariables.set('userUrl',                      // from a header",
                  "  pm.response.headers.get('Location'));",
                  "",
                  "pm.test('Location header points at the new user', function () {",
                  "  pm.expect(pm.response.headers.get('Location'))",
                  "    .to.eql('/api/users/' + user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"role\": \"tester\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Saves userId (from the body) and userUrl (from the Location header)."
          },
          "response": []
        },
        {
          "name": "Read the new user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.response.json();",
                  "",
                  "pm.test('Read returns exactly what we created', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(user.id).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "  pm.expect(user.name).to.eql(pm.collectionVariables.get('userName'));",
                  "  pm.expect(user.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "  pm.expect(user.role).to.eql('tester');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{userUrl}}",
            "description": "Uses the Location header value saved by the create request."
          },
          "response": []
        },
        {
          "name": "Update the role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.response.json();",
                  "",
                  "pm.test('Role changed to manager, other fields kept', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(user.role).to.eql('manager');",
                  "  pm.expect(user.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "  pm.expect(user).to.have.property('updatedAt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Verify the update",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A fresh GET shows the new role (it was saved)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().role).to.eql('manager');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete the user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delete returns 204 with an empty body', function () {",
                  "  pm.response.to.have.status(204);",
                  "  pm.expect(pm.response.text()).to.eql('');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify the user is gone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The deleted user is gone (404)', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('USER_NOT_FOUND');",
                  "});",
                  "",
                  "// Clean up: leave no values behind for the next run",
                  "['userId', 'userUrl', 'userName', 'userEmail']",
                  "  .forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 Order flow",
      "description": "Login -> read stock -> place order -> verify stock -> cancel -> verify stock is restored. The folder uses Bearer {{token}}; the login request saves the token.",
      "item": [
        {
          "name": "Log in as tester",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login works (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set('token', token);   // used by the folder's auth",
                  "",
                  "pm.test('Token looks like a JWT', function () {",
                  "  pm.expect(token.split('.')).to.have.lengthOf(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Read stock before ordering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// /debug/db shows the \"database\": read product 2 before we buy",
                  "const row = pm.response.json().rows.find(p => p.id === 2);",
                  "pm.collectionVariables.set('stockBefore', row.stock);",
                  "pm.collectionVariables.set('price', row.price);",
                  "",
                  "pm.test('Product 2 has at least 2 in stock', function () {",
                  "  pm.expect(row.stock).to.be.at.least(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/db?table=products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "db"
              ],
              "query": [
                {
                  "key": "table",
                  "value": "products"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Place an order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const order = pm.response.json();",
                  "",
                  "pm.test('Order is placed (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Order belongs to tester, total = price x 2', function () {",
                  "  pm.expect(order.owner).to.eql(pm.environment.get('username'));",
                  "  pm.expect(order.status).to.eql('PLACED');",
                  "  const price = Number(pm.collectionVariables.get('price'));",
                  "  pm.expect(order.total).to.eql(price * 2);",
                  "});",
                  "",
                  "pm.collectionVariables.set('orderId', order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 2,\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Verify stock went down",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const row = pm.response.json().rows.find(p => p.id === 2);",
                  "const before = Number(pm.collectionVariables.get('stockBefore'));",
                  "",
                  "pm.test('Stock went down by exactly 2', function () {",
                  "  pm.expect(row.stock).to.eql(before - 2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/db?table=products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "db"
              ],
              "query": [
                {
                  "key": "table",
                  "value": "products"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Read the order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The order can be read back and is PLACED', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const order = pm.response.json();",
                  "  pm.expect(order.id).to.eql(Number(pm.collectionVariables.get('orderId')));",
                  "  pm.expect(order.status).to.eql('PLACED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel the order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancel works and the status is CANCELLED', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('CANCELLED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel it again (refused)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancelling twice is refused (409 CANNOT_CANCEL)', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error.code).to.eql('CANNOT_CANCEL');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify stock is restored",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const row = pm.response.json().rows.find(p => p.id === 2);",
                  "",
                  "pm.test('Stock is back to where it started', function () {",
                  "  const before = Number(pm.collectionVariables.get('stockBefore'));",
                  "  pm.expect(row.stock).to.eql(before);",
                  "});",
                  "",
                  "['token', 'orderId', 'stockBefore', 'price']",
                  "  .forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/db?table=products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "db"
              ],
              "query": [
                {
                  "key": "table",
                  "value": "products"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "3 Exercise answer: product lifecycle",
      "description": "Answer to the Try It Yourself exercise of Chapter 19: admin login -> create product -> read it (Location header) -> delete -> verify 404.",
      "item": [
        {
          "name": "Log in as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login works (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Create a product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product created (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('productUrl', pm.response.headers.get('Location'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chain Test Lamp\",\n  \"category\": \"home\",\n  \"price\": 999,\n  \"stock\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Read the product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Read returns the product we created', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().name).to.eql('Chain Test Lamp');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{productUrl}}"
          },
          "response": []
        },
        {
          "name": "Delete the product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delete returns 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}{{productUrl}}"
          },
          "response": []
        },
        {
          "name": "Verify the product is gone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The product is gone (404 PRODUCT_NOT_FOUND)', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('PRODUCT_NOT_FOUND');",
                  "});",
                  "['adminToken', 'productUrl'].forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{productUrl}}"
          },
          "response": []
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      }
    }
  ],
  "variable": []
}
