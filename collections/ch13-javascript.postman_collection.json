  "item": [
    {
      "name": "01 Values and types",
      "description": "typeof, numbers vs strings, undefined and null.",
      "item": [
        {
          "name": "Types of values",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.response.json();",
                  "",
                  "console.log(typeof user.name);     // text",
                  "console.log(typeof user.id);       // a number",
                  "console.log(typeof user.active);   // true or false",
                  "console.log(typeof user);          // the whole user",
                  "console.log(typeof user.phone);    // a field that does not exist",
                  "console.log(user.phone);",
                  "",
                  "// 1 and '1' look alike in a report, but they are different types",
                  "console.log(user.id === 1, user.id === '1');",
                  "",
                  "// an old JavaScript quirk worth knowing",
                  "console.log(typeof null, Array.isArray([1, 2]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "1"
              ]
            },
            "description": "Reads one user and prints the type of each value."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 const and let",
      "description": "Declaring variables, changing them, and where they are visible.",
      "item": [
        {
          "name": "const, let and scope",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('baseUrl');   // will not change",
                  "let attempts = 0;                                 // will change",
                  "",
                  "attempts = attempts + 1;",
                  "attempts += 1;                         // same as attempts = attempts + 1",
                  "console.log(baseUrl, attempts);",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const message = 'only visible inside these braces';",
                  "  console.log(message);",
                  "}",
                  "console.log(typeof message);                      // not visible out here"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "No response data needed: the script is about variables."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 Strings and template literals",
      "description": "Joining text, template literals and the string methods testers use.",
      "item": [
        {
          "name": "Working with text",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.response.json();",
                  "",
                  "const joined = 'Hello, ' + user.name + '!';                 // with +",
                  "const summary = `User ${user.id} is ${user.name} (${user.role})`;",
                  "console.log(joined);",
                  "console.log(summary);",
                  "",
                  "console.log(user.email.length);",
                  "console.log(user.email.includes('@'));",
                  "console.log(user.email.endsWith('@example.com'));",
                  "console.log(user.name.toUpperCase());",
                  "console.log(user.email.split('@'));",
                  "console.log('[' + '  spaces around  '.trim() + ']');",
                  "",
                  "const type = pm.response.headers.get('Content-Type');",
                  "console.log(type, type.startsWith('application/json'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "1"
              ]
