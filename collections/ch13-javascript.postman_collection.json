                  "console.log(body.data.length);       // only 2 users came back",
                  "console.log(body.data[5]);           // nothing at index 5",
                  "console.log(body.data[5]?.email);    // ?. stops safely instead of failing",
                  "",
                  "const user = body.data[5];",
                  "if (user) {",
                  "  console.log(user.email);",
