    {
      "name": "04 Objects and arrays",
      "description": "Reading a JSON response: dot access, bracket access, indexes.",
      "item": [
        {
          "name": "Read a list response",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "console.log(body.page, body.limit, body.total);   // dot access",
                  "console.log(body['totalPages']);                  // bracket access",
                  "console.log(body.data.length);                    // how many items",
                  "console.log(body.data[0].name);                   // first item",
                  "console.log(body.data[body.data.length - 1].email); // last item",
                  "",
                  "const field = 'role';                             // a key held in a variable",
                  "console.log(body.data[0][field]);                 // needs brackets",
                  "",
                  "console.log(Object.keys(body.data[0]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            },
            "description": "A page of 3 users: page, limit, total and the data array."
          },
          "response": []
        },
        {
          "name": "Keys with dashes need brackets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const echo = pm.response.json();",
                  "",
                  "console.log(echo.headers['x-request-id']);",
                  "console.log(echo.headers['user-agent']);",
                  "console.log(echo.headers.host);           // no dash: dot access works",
                  "",
                  "// echo.headers.x-request-id would mean: echo.headers.x minus request minus id"
                ]
              }
            }
          ],
