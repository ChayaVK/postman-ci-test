    {
      "name": "05 Functions",
      "description": "Function declarations, arrow functions and callbacks.",
      "item": [
        {
          "name": "Functions and arrow functions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function priceWithTax(price, rate) {",
                  "  return price + price * rate;",
                  "}",
                  "const isCheap = (product) => product.price < 1000;    // arrow function",
                  "const label = p => `${p.name}: ${p.price}`;          // one parameter",
                  "",
                  "const products = pm.response.json().data;",
                  "console.log(priceWithTax(products[0].price, 0.18));",
                  "console.log(products.map(label));",
                  "console.log(isCheap(products[0]), isCheap(products[1]));",
                  "",
                  "// a callback: a function you hand to another function to call later",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            },
            "description": "Small functions applied to the first products."
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 Conditions",
      "description": "if / else, === vs ==, truthy and falsy values.",
      "item": [
        {
          "name": "if, else and comparisons",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const product = pm.response.json();",
                  "",
                  "if (product.stock === 0) {",
                  "  console.log(`${product.name} is out of stock`);",
                  "} else if (product.stock < 10) {",
                  "  console.log(`${product.name}: only ${product.stock} left`);",
                  "} else {",
                  "  console.log(`${product.name} is in stock`);",
                  "}",
                  "",
                  "console.log(pm.response.code === 200 && product.price > 0);   // AND",
                  "console.log(product.stock > 0 || product.price < 100);        // OR",
                  "console.log(1 == '1', 1 === '1');                              // loose, strict",
                  "const label = product.stock > 0 ? 'IN STOCK' : 'SOLD OUT';    // short if/else",
                  "console.log(label);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "3"
              ]
            },
            "description": "Product 3 (USB-C Charger) has stock 0."
          },
          "response": []
        },
        {
          "name": "The falsy trap",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const product = pm.response.json();",
                  "",
                  "console.log(Boolean(0), Boolean(''), Boolean(null), Boolean(undefined));",
                  "console.log(Boolean('0'), Boolean('false'), Boolean([]), Boolean({}));",
                  "",
                  "// Wrong: 0 is falsy, so a real stock of 0 looks \"missing\"",
                  "if (!product.stock) {",
                  "  console.log('Looks missing, but stock is', product.stock);",
                  "}",
                  "// Right: ask the exact question",
                  "if (product.stock === undefined) {",
                  "  console.log('never printed: the field is there');",
                  "}",
                  "console.log('stock' in product, product.stock === 0);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "3"
              ]
            },
            "description": "Why `if (!value)` is a bad way to check that a field exists."
          },
          "response": []
        }
      ]
    },
    {
      "name": "07 Loops",
      "description": "for...of, forEach and the classic for loop.",
      "item": [
        {
          "name": "Loop over users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const users = pm.response.json().data;",
                  "",
                  "for (const user of users) {                 // for...of: one item at a time",
                  "  if (!user.active) {",
                  "    console.log(`Inactive: ${user.id} ${user.name}`);",
                  "  }",
                  "}",
                  "",
                  "users.forEach((user, index) => {            // forEach also gives the index",
                  "  if (index < 2) console.log(index, user.email);",
                  "});",
                  "",
                  "for (let i = 0; i < 3; i++) {               // classic loop with a counter",
                  "  console.log('i =', i, users[i].role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?limit=8",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "8"
                }
              ]
            },
            "description": "All 8 starting users; two of them are inactive."
          },
          "response": []
        }
      ]
    },
    {
      "name": "08 Array methods",
      "description": "find, filter, map, some, every, includes and sort.",
      "item": [
        {
          "name": "find, filter, map, some, every",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const products = pm.response.json().data;",
                  "",
                  "const lamp = products.find(p => p.id === 6);              // first match",
                  "const home = products.filter(p => p.category === 'home'); // all matches",
                  "const names = products.map(p => p.name);                 // transform each",
                  "const anyOut = products.some(p => p.stock === 0);        // at least one?",
                  "const allPriced = products.every(p => p.price > 0);      // all of them?",
                  "",
                  "console.log(lamp.name, lamp.price);",
                  "console.log(home.length, home.map(p => p.name));",
                  "console.log(names.slice(0, 3));",
                  "console.log('Any out of stock?', anyOut);",
                  "console.log('All have a price?', allPriced);",
                  "console.log(names.includes('Coffee Mug'));",
                  "console.log(products.find(p => p.id === 99));            // no match"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?limit=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "12"
                }
              ]
            },
            "description": "All 12 products."
          },
          "response": []
        },
        {
          "name": "Is the list really sorted?",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const prices = pm.response.json().data.map(p => p.price);",
                  "const expected = [...prices].sort((a, b) => b - a);   // copy, then sort",
                  "",
                  "console.log(prices.join(', '));",
                  "console.log('High to low?', prices.every((v, i) => v === expected[i]));",
                  "",
                  "// Trap: sort() without a compare function sorts as TEXT",
                  "console.log([10, 9, 100].sort());",
                  "console.log([10, 9, 100].sort((a, b) => a - b));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?sort=-price&limit=6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "-price"
                },
                {
                  "key": "limit",
                  "value": "6"
                }
              ]
            },
            "description": "The six most expensive products, sorted by price, high to low."
          },
          "response": []
        }
      ]
    },
    {
      "name": "09 JSON.parse and JSON.stringify",
      "description": "Turning objects into text for a request body, and text back into objects.",
      "item": [
        {
          "name": "Build a body, read the response",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = {",
                  "  name: 'Script User',",
                  "  email: `script.${Date.now()}@example.com`,",
                  "  role: 'tester'",
                  "};",
                  "const text = JSON.stringify(user);       // object -> JSON text",
                  "console.log(typeof text, text);",
                  "pm.variables.set('newUserBody', text);   // the Body tab uses {{newUserBody}}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fromHelper = pm.response.json();             // Postman parses it",
                  "const fromText = JSON.parse(pm.response.text());   // the same, by hand",
                  "",
                  "console.log(pm.response.code, fromHelper.id === fromText.id);",
                  "console.log(JSON.stringify(fromHelper));           // one line",
                  "const small = { id: fromHelper.id, role: fromHelper.role };",
                  "console.log(JSON.stringify(small, null, 2));          // indented"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "The pre-request script builds the JSON body; the post-response script reads the 201 response.",
            "body": {
              "mode": "raw",
              "raw": "{{newUserBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
