{
  "info": {
    "_postman_id": "88707637-91cb-509e-9225-f10a34cff40e",
    "name": "Ch24 Microservices, Logs and Databases",
    "description": "Chapter 24 of *API Testing with Postman: The Complete Course*.\n\nFollows requests with correlation IDs (`X-Request-Id`), reads the server log with `GET /api/logs`, and checks side effects in the database view `GET /debug/db`.\n\nNeeds the practice API on `{{baseUrl}}` and the environment **Practice API - Local**. Run the whole collection in order (Collection Runner or Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Follow one request",
      "description": "Send a request with a correlation ID, then find its log lines.",
      "item": [
        {
          "name": "Log in as tester",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Gets a JWT and saves it as `token`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Place an order (traced)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "// Remember the ID of this request so we can look it up in the log.",
                  "pm.collectionVariables.set('tracedId', pm.response.headers.get('X-Request-Id'));",
                  "pm.collectionVariables.set('tracedOrderId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Places an order. The collection pre-request script adds the `X-Request-Id` header.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Read the server log for that request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const traced = pm.collectionVariables.get('tracedId');",
                  "const orderId = pm.collectionVariables.get('tracedOrderId');",
                  "const entries = pm.response.json().entries;",
                  "console.log(entries);",
                  "",
                  "pm.test('The log has lines for our request', () => {",
                  "  pm.expect(entries.length).to.be.above(0);",
                  "});",
                  "pm.test('Every line carries our correlation ID', () => {",
                  "  pm.expect(entries.every(e => e.requestId === traced)).to.be.true;",
                  "});",
                  "pm.test('The order service logged the new order', () => {",
                  "  const msgs = entries.map(e => e.msg);",
                  "  pm.expect(msgs).to.include(`order ${orderId} placed by tester`);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/logs?requestId={{tracedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "logs"
              ],
              "query": [
                {
                  "key": "requestId",
                  "value": "{{tracedId}}"
                }
              ]
            },
            "description": "Every log line the server wrote while handling the traced request."
          }
        }
      ]
    },
    {
      "name": "2 Triage a failed request",
      "description": "A request fails; the request ID leads to the reason in the log.",
      "item": [
        {
          "name": "Place an order that fails (quantity 11)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Error body repeats the request ID', () => {",
                  "  pm.expect(body.requestId).to.eql(pm.response.headers.get('X-Request-Id'));",
                  "});",
                  "pm.collectionVariables.set('failedId', body.requestId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "quantity must be 1 to 10, so this fails with 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 11\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Find the failure in the server log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const entries = pm.response.json().entries;",
                  "console.log(entries.map(e => `${e.time} ${e.method} ${e.path} | ${e.msg}`));",
                  "pm.test('The log explains why the request failed', () => {",
                  "  const err = entries.find(e => e.msg.startsWith('400 '));",
                  "  pm.expect(err, 'no 400 line in the log').to.exist;",
                  "  pm.expect(err.msg).to.include('VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/logs?requestId={{failedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "logs"
              ],
              "query": [
                {
                  "key": "requestId",
                  "value": "{{failedId}}"
                }
              ]
            },
            "description": "Looks up the failed request by the requestId from its error body."
          }
        }
      ]
    },
    {
      "name": "3 Check side effects in the database",
      "description": "An order must add an orders row and reduce stock; cancelling must put the stock back.",
      "item": [
        {
          "name": "Stock before (products table)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const keyboard = pm.response.json().rows.find(p => p.id === 2);",
                  "pm.collectionVariables.set('stockBefore', keyboard.stock);",
                  "console.log('Stock of product 2 before the order:', keyboard.stock);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/db?table=products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "db"
              ],
              "query": [
                {
                  "key": "table",
                  "value": "products"
                }
              ]
            },
            "description": "Reads the stock of product 2 (Mechanical Keyboard) before the order."
          }
        },
        {
          "name": "Place an order for 3 keyboards",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('keyboardOrderId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 2,\n  \"quantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Orders table has the new row",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Number(pm.collectionVariables.get('keyboardOrderId'));",
                  "const row = pm.response.json().rows.find(o => o.id === id);",
                  "",
                  "pm.test('The orders table has a row for the new order', () => {",
                  "  pm.expect(row, `no row with id ${id}`).to.exist;",
                  "});",
                  "pm.test('The row has the right values', () => {",
                  "  pm.expect(row.owner).to.eql('tester');",
                  "  pm.expect(row.productId).to.eql(2);",
                  "  pm.expect(row.quantity).to.eql(3);",
                  "  pm.expect(row.total).to.eql(3 * 3499);",
                  "  pm.expect(row.status).to.eql('PLACED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/db?table=orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "db"
              ],
              "query": [
                {
                  "key": "table",
                  "value": "orders"
                }
              ]
            }
          }
        },
        {
          "name": "Products table: stock went down by 3",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const before = Number(pm.collectionVariables.get('stockBefore'));",
                  "const keyboard = pm.response.json().rows.find(p => p.id === 2);",
                  "pm.test('Stock went down by exactly 3', () => {",
                  "  pm.expect(keyboard.stock).to.eql(before - 3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/db?table=products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "db"
              ],
              "query": [
                {
                  "key": "table",
                  "value": "products"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel the order (clean up)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Order is CANCELLED', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('CANCELLED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{keyboardOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{keyboardOrderId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Products table: stock is back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const before = Number(pm.collectionVariables.get('stockBefore'));",
                  "const keyboard = pm.response.json().rows.find(p => p.id === 2);",
                  "pm.test('Cancelling put the stock back', () => {",
                  "  pm.expect(keyboard.stock).to.eql(before);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debug/db?table=products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug",
                "db"
              ],
              "query": [
                {
                  "key": "table",
                  "value": "products"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tag every request with its own correlation ID (unless it already has one),",
          "// so its server log lines can be found later with GET /api/logs.",
          "if (!pm.request.headers.has('X-Request-Id')) {",
          "  const id = 'qa-' + pm.variables.replaceIn('{{$guid}}');",
          "  pm.request.headers.add({ key: 'X-Request-Id', value: id });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every response must echo the correlation ID that we sent.",
          "pm.test('Response echoes our X-Request-Id', () => {",
          "  pm.expect(pm.response.headers.get('X-Request-Id'))",
          "    .to.eql(pm.request.headers.get('X-Request-Id'));",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tracedId",
      "value": ""
    },
    {
      "key": "tracedOrderId",
      "value": ""
    },
    {
      "key": "failedId",
      "value": ""
    },
    {
      "key": "stockBefore",
      "value": ""
    },
    {
      "key": "keyboardOrderId",
      "value": ""
    }
  ]
}
