                "type": "text/javascript",
                "exec": [
                  "// v2 must return the same users as the unversioned /api/users",
                  "const v2 = pm.response.json();",
                  "",
                  "pm.test('v2 has no Deprecation header', function () {",
                  "  pm.response.to.not.have.header('Deprecation');",
                  "});",
                  "",
                  "pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}/api/users?limit=50'),",
                  "  function (err, res) {",
                  "    pm.test('v2 and /api/users return the same data', function () {",
                  "      pm.expect(err).to.be.null;",
                  "      pm.expect(v2.data).to.eql(res.json().data);",
                  "    });",
                  "  });"
                ]
              }
            }
