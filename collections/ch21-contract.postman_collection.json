    {
      "name": "3 Versioning",
      "description": "Old and new versions of the users API side by side.",
      "item": [
        {
          "name": "v1 users (deprecated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const users = pm.response.json();",
                  "",
                  "pm.test('v1 still answers for old clients (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('v1 keeps its own shape: id, fullName, mail', function () {",
                  "  pm.expect(users[0]).to.have.all.keys('id', 'fullName', 'mail');",
                  "});",
                  "",
                  "pm.test('v1 announces its retirement', function () {",
                  "  pm.expect(pm.response.headers.get('Deprecation')).to.eql('true');",
                  "  const sunset = new Date(pm.response.headers.get('Sunset'));",
                  "  pm.expect(sunset.getTime()).to.not.be.NaN;",
                  "  pm.expect(pm.response.headers.get('Link')).to.include('successor-version');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "v1 and v2 agree on user 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Same user in both versions: fields renamed, values must agree",
                  "const v1 = pm.response.json().find(u => u.id === 1);",
                  "",
                  "pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}/api/users/1'),",
                  "  function (err, res) {",
                  "    const v2 = res.json();",
                  "    pm.test('v1 fullName/mail equal v2 name/email for user 1', function () {",
                  "      pm.expect(v1.fullName).to.eql(v2.name);",
                  "      pm.expect(v1.mail).to.eql(v2.email);",
                  "    });",
                  "  });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
