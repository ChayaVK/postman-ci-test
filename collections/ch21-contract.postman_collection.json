      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Contract check: runs after every request in this folder.",
              "const spec = JSON.parse(pm.collectionVariables.get('openapi'));",
              "const path = pm.request.url.getPath();          // e.g. /api/users/1",
              "const method = pm.request.method.toLowerCase(); // e.g. get",
              "const status = String(pm.response.code);        // e.g. 200",
              "",
              "// Find the contract path whose template fits, e.g. /api/users/{id}",
              "const tpl = Object.keys(spec.paths).find(p =>",
              "  new RegExp('^' + p.replace(/\\{[^}]+\\}/g, '[^/]+') + '$').test(path));",
              "const op = tpl && spec.paths[tpl][method];",
              "",
              "pm.test(`[contract] ${method.toUpperCase()} ${tpl} is documented`, () => {",
              "  pm.expect(op, 'operation in /openapi.json').to.exist;",
              "});",
              "pm.test(`[contract] ${status} is a documented response`, () => {",
              "  pm.expect(op.responses).to.have.property(status);",
              "});",
              "",
              "const content = op && op.responses[status] && op.responses[status].content;",
              "const schema = content && content['application/json'] &&",
              "  content['application/json'].schema;",
              "if (schema) {",
              "  pm.test(`[contract] body matches the ${status} schema`, () => {",
              "    // components lets $ref like #/components/schemas/User resolve",
              "    pm.response.to.have.jsonSchema({ ...schema, components: spec.components });",
              "  });",
              "}"
            ]
          }
        }
      ]
