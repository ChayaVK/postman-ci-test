          "// and names of exactly 50 and 51 characters.",
          "const rand = Math.floor(Math.random() * 1e6);",
          "pm.variables.set('uniqueEmail', `case.${Date.now()}.${rand}@example.com`);",
          "pm.variables.set('name50', 'N'.repeat(50));",
          "pm.variables.set('name51', 'N'.repeat(51));"
        ]
      }
    }
