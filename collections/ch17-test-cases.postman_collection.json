                  "const mouse = pm.response.json().rows.find(p => p.id === 1);",
                  "pm.test('O02 stock of product 1 is 25 - 2', () => {",
                  "  pm.expect(mouse.stock).to.eql(23);",
                  "});"
                ]
              }
            }
          ],
          "request": {
