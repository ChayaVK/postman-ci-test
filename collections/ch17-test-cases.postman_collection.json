    {
      "name": "POST /api/orders",
      "description": "Cases O01-O15. The folder script logs in once (tester and buyer2).",
      "item": [
        {
          "name": "O01 Valid order, quantity 2 -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('O01 status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const o = pm.response.json();",
                  "pm.test('O01 total = price x quantity, status PLACED, owner tester', () => {",
                  "  pm.expect(o.total).to.eql(799 * 2);",
                  "  pm.expect(o.status).to.eql('PLACED');",
                  "  pm.expect(o.owner).to.eql('tester');",
                  "});",
                  "pm.collectionVariables.set('orderId', o.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
