  "item": [
    {
      "name": "POST /api/users",
      "description": "Cases U01-U18.",
      "item": [
        {
          "name": "U01 Valid name and email only -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('U01 status 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const u = pm.response.json();",
                  "pm.test('U01 defaults: role tester, active true, Location', () => {",
                  "  pm.expect(u.role).to.eql('tester');",
                  "  pm.expect(u.active).to.eql(true);",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/users/' + u.id);",
                  "});",
                  "pm.collectionVariables.set('createdUserId', u.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Khan\",\n  \"email\": \"{{uniqueEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "U02 All fields valid -> 201",
          "event": [
            {
