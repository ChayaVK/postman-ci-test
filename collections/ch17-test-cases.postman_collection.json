      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Log in as tester and buyer2 once,",
              "// and make a tampered copy of the tester token.",
              "const base = pm.environment.get('baseUrl');",
              "const login = (user, pass, varName, done) => pm.sendRequest({",
              "  url: base + '/api/auth/login', method: 'POST',",
              "  header: { 'Content-Type': 'application/json' },",
              "  body: { mode: 'raw', raw: JSON.stringify({ username: user, password: pass }) }",
              "}, (err, res) => {",
              "  pm.collectionVariables.set(varName, res.json().token);",
              "  if (done) done();",
              "});",
              "",
              "if (!pm.collectionVariables.get('token')) {",
              "  const user = pm.environment.get('username');",
              "  const pass = pm.environment.get('password');",
              "  login(user, pass, 'token', () => {",
              "    const t = pm.collectionVariables.get('token');",
              "    const last = t.slice(-1) === 'A' ? 'B' : 'A';",
              "    pm.collectionVariables.set('tamperedToken', t.slice(0, -1) + last);",
              "  });",
              "  login('buyer2', 'Buyer@123', 'buyer2Token');",
              "}"
            ]
          }
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      }
    }
  ],
