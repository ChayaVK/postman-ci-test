{
  "info": {
    "_postman_id": "c06a3edb-2440-5953-b6aa-e26c8341e16d",
    "name": "Ch 15 - SOAP and GraphQL in Postman",
    "description": "SOAP requests (raw XML body, Content-Type text/xml, SOAPAction header, faults) and GraphQL requests (GraphQL body type with query and variables, aliases, a mutation, and errors that come with HTTP 200).\n\nWebSocket requests cannot live in the same collection as HTTP requests in Postman, so the WebSocket steps of Chapter 15 use a separate WebSocket request (New > WebSocket, ws://localhost:3000/ws).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SOAP calculator",
      "description": "SOAP 1.1 requests to POST /soap/calculator. WSDL: GET /soap/calculator?wsdl.",
      "item": [
        {
          "name": "Get the WSDL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const wsdl = pm.response.text();",
                  "const ops = [...wsdl.matchAll(/soapAction=\"([^\"]+)\"/g)].map(m => m[1]);",
                  "console.log(ops);",
                  "console.log(wsdl.match(/location=\"([^\"]+)\"/)[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/soap/calculator?wsdl",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soap",
                "calculator"
              ],
              "query": [
                {
                  "key": "wsdl"
                }
              ]
            },
            "description": "The service description: operations, messages, SOAPAction values and address."
          },
          "response": []
        },
        {
          "name": "Add 7 + 5",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const xml = pm.response.text();",
                  "const result = xml.match(/<AddResult>(.*?)<\\/AddResult>/)[1];   // text!",
                  "",
                  "pm.test('HTTP 200 and the result is 12', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(Number(result)).to.eql(12);",
                  "});",
                  "console.log(pm.response.headers.get('Content-Type'), '| AddResult =', result);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://practice-api.local/calculator/Add\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/soap/calculator",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soap",
                "calculator"
              ]
            },
            "description": "A correct SOAP request: XML envelope, Content-Type text/xml and SOAPAction.",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <Add xmlns=\"http://practice-api.local/calculator\">\n      <intA>7</intA>\n      <intB>5</intB>\n    </Add>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Divide by zero (fault)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const xml = pm.response.text();",
                  "const code = xml.match(/<faultcode>(.*?)<\\/faultcode>/)[1];",
                  "const text = xml.match(/<faultstring>(.*?)<\\/faultstring>/)[1];",
                  "",
                  "pm.test('Fault: HTTP 500 and soap:Server', () => {",
                  "  pm.response.to.have.status(500);",
                  "  pm.expect(code).to.eql('soap:Server');",
                  "});",
                  "console.log(code, '|', text);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://practice-api.local/calculator/Divide\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/soap/calculator",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soap",
                "calculator"
              ]
            },
            "description": "A server-side SOAP fault: HTTP 500 with a soap:Fault in the body.",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <Divide xmlns=\"http://practice-api.local/calculator\">\n      <intA>10</intA>\n      <intB>0</intB>\n    </Divide>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Missing intB (client fault)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const xml = pm.response.text();",
                  "pm.test('Fault: HTTP 500 and soap:Client', () => {",
                  "  pm.response.to.have.status(500);",
                  "  pm.expect(xml).to.include('<faultcode>soap:Client</faultcode>');",
                  "});",
                  "console.log(xml.match(/<faultstring>(.*?)<\\/faultstring>/)[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://practice-api.local/calculator/Multiply\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/soap/calculator",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soap",
                "calculator"
              ]
            },
            "description": "The request is wrong: soap:Client fault.",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <Multiply xmlns=\"http://practice-api.local/calculator\">\n      <intA>6</intA>\n    </Multiply>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Postman default XML type (client fault)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const xml = pm.response.text();",
                  "pm.test('application/xml is refused with a client fault', () => {",
                  "  pm.response.to.have.status(500);",
                  "  pm.expect(xml).to.include('soap:Client');",
                  "});",
                  "console.log(xml.match(/<faultstring>(.*?)<\\/faultstring>/)[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://practice-api.local/calculator/Add\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/soap/calculator",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soap",
                "calculator"
              ]
            },
            "description": "Content-Type application/xml, the type Postman picks for raw XML. This service wants text/xml.",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <Add xmlns=\"http://practice-api.local/calculator\">\n      <intA>7</intA>\n      <intB>5</intB>\n    </Add>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "GraphQL",
      "description": "GraphQL requests to POST /graphql using the GraphQL body type. Schema: GET /graphql/schema.",
      "item": [
        {
          "name": "Read the schema (SDL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sdl = pm.response.text();",
                  "console.log(sdl.split('\\n').slice(0, 6).join('\\n'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql/schema",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql",
                "schema"
              ]
            },
            "description": "The practice schema as text. Introspection is turned off on this server."
          },
          "response": []
        },
        {
          "name": "What Postman sends for a GraphQL body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const echo = pm.response.json();",
                  "console.log(echo.contentType);",
                  "console.log(echo.body);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/echo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "echo"
              ]
            },
            "description": "Sends a GraphQL body to the echo endpoint to show the real HTTP request.",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ($limit: Int) {\n  users(limit: $limit) { id name }\n}",
                "variables": "{\n  \"limit\": 2\n}"
              }
            }
          },
          "response": []
        },
        {
          "name": "Users: only the fields you ask for",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200, no errors, 3 users with exactly id, name, role', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.errors).to.be.undefined;",
                  "  pm.expect(body.data.users).to.have.length(3);",
                  "  pm.expect(Object.keys(body.data.users[0])).to.eql(['id', 'name', 'role']);",
                  "});",
                  "console.log(JSON.stringify(body.data.users));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Ask for three fields of three users.",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  users(limit: 3) {\n    id\n    name\n    role\n  }\n}",
                "variables": ""
              }
            }
          },
          "response": []
        },
        {
          "name": "Query with variables",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const users = pm.response.json().data.users;",
                  "pm.test('every user returned is a manager', () => {",
                  "  pm.expect(users.length).to.be.above(0);",
                  "  pm.expect(users.every(u => u.role === 'manager')).to.be.true;",
                  "});",
                  "console.log(users.map(u => u.name));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "The query declares $role and $limit; the GraphQL variables pane gives their values.",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query UsersByRole($role: String, $limit: Int) {\n  users(role: $role, limit: $limit) {\n    id\n    name\n    role\n  }\n}",
                "variables": "{\n  \"role\": \"manager\",\n  \"limit\": 5\n}"
              }
            }
          },
          "response": []
        },
        {
          "name": "Aliases: two products in one call",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const result = pm.response.json().data;",
                  "pm.test('the charger is out of stock', () => {",
                  "  pm.expect(result.charger.inStock).to.be.false;",
                  "});",
                  "console.log(result);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Aliases (mouse:, charger:) let one query ask for the same field twice.",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  mouse: product(id: 1) { name price inStock }\n  charger: product(id: 3) { name price inStock }\n}",
                "variables": ""
              }
            }
          },
          "response": []
        },
        {
          "name": "Mutation: create a user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('user created, no errors', () => {",
                  "  pm.expect(body.errors).to.be.undefined;",
                  "  pm.expect(body.data.createUser.role).to.eql('developer');",
                  "});",
                  "console.log(body.data.createUser);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "A mutation changes data. {{$timestamp}} keeps the email unique.",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation NewUser($name: String!, $email: String!) {\n  createUser(name: $name, email: $email, role: \"developer\") {\n    id\n    name\n    email\n    role\n  }\n}",
                "variables": "{\n  \"name\": \"Graph User\",\n  \"email\": \"graph.{{$timestamp}}@example.com\"\n}"
              }
            }
          },
          "response": []
        },
        {
          "name": "Error inside a 200 response",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status 200 does NOT mean success here', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.data.createUser).to.be.null;",
                  "  pm.expect(body.errors[0].message).to.include('not a valid email');",
                  "});",
                  "console.log(pm.response.code, JSON.stringify(body));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "An invalid email: HTTP 200, data.createUser is null and the reason is in errors[].",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  createUser(name: \"Bad Email\", email: \"not-an-email\") {\n    id\n  }\n}",
                "variables": ""
              }
            }
          },
          "response": []
        },
        {
          "name": "Unknown field (400 on this server)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('the query is rejected and explained', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "  pm.expect(body.errors[0].message).to.include('phone');",
                  "});",
                  "console.log(pm.response.code, body.errors[0].message);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Asking for a field that is not in the schema. This server answers 400; many servers answer 200 with errors[].",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{\n  users(limit: 1) {\n    id\n    phone\n  }\n}",
                "variables": ""
              }
            }
          },
          "response": []
        }
      ]
    }
  ]
}
