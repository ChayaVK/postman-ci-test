            }
          ]
        },
        {
          "name": "Another user's order is hidden",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/1002",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Order 1002 belongs to buyer2. tester must not see it.",
                  "pm.test('Status is 404, not 200', () => pm.response.to.have.status(404));",
                  "pm.test('No order data leaks', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('buyer2');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Errors do not leak internals",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": ",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('No stack trace or file paths', () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.match(/at \\w+ \\(|\\.js:\\d+|stack/i);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
