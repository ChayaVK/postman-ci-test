    {
      "name": "02 CRUD on users",
      "item": [
        {
          "name": "Create a user",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Khan\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"role\": \"tester\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new email on every run, so the request never hits \"email already used\"",
                  "pm.collectionVariables.set('uniqueEmail', `sara.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "// Save the new id for the next requests",
                  "pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the new user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace the user (PUT)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Khan\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"role\": \"developer\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Role is now developer', () => pm.expect(pm.response.json().role).to.eql('developer'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change one field (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('User is inactive', () => pm.expect(pm.response.json().active).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read it after delete",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Authentication",
      "item": [
        {
          "name": "Log in as tester",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "// Save the token for the next requests",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (Bearer token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Orders without a token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sales report (API key)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reports/sales",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile (Basic auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/basic/profile",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Writing tests",
      "item": [
        {
          "name": "Get one user, fully tested",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Answers within 1 second', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('Body is JSON', () => {",
                  "  pm.response.to.have.header('Content-Type', 'application/json; charset=utf-8');",
                  "});",
                  "",
                  "const user = pm.response.json();",
                  "",
                  "pm.test('It is user 1, Asha Rao', () => {",
                  "  pm.expect(user.id).to.eql(1);",
                  "  pm.expect(user.name).to.eql('Asha Rao');",
                  "});",
                  "",
                  "pm.test('Fields have the right types', () => {",
                  "  pm.expect(user.email).to.be.a('string').and.include('@');",
                  "  pm.expect(user.active).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List testers, check every item",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users?role=tester"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('data is a non-empty array', () => {",
                  "  pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('Every user returned is a tester', () => {",
                  "  body.data.forEach(u => pm.expect(u.role).to.eql('tester'));",
                  "});",
                  "",
                  "pm.test('total matches the number of items', () => {",
                  "  pm.expect(body.total).to.eql(body.data.length);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Check the shape with a JSON Schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['id', 'name', 'email', 'role', 'active', 'createdAt'],",
                  "  properties: {",
                  "    id:        { type: 'integer', minimum: 1 },",
                  "    name:      { type: 'string', minLength: 2, maxLength: 50 },",
                  "    email:     { type: 'string', format: 'email' },",
                  "    role:      { type: 'string', enum: ['tester', 'developer', 'manager', 'admin'] },",
                  "    active:    { type: 'boolean' },",
                  "    createdAt: { type: 'string', format: 'date-time' }",
                  "  },",
                  "  additionalProperties: false",
                  "};",
                  "",
                  "pm.test('Body matches the user schema', () => {",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid user is rejected (400)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "",
                  "const err = pm.response.json().error;",
                  "",
                  "pm.test('Error code is VALIDATION_FAILED', () => {",
                  "  pm.expect(err.code).to.eql('VALIDATION_FAILED');",
                  "});",
                  "",
                  "pm.test('Both wrong fields are named', () => {",
                  "  const fields = err.details.map(d => d.field);",
                  "  pm.expect(fields).to.include.members(['name', 'email']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown user gives a clear 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error code is USER_NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('USER_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Chaining: place an order",
      "item": [
        {
          "name": "Log in as tester",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "// Save the token for the next requests",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find a product in stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?inStock=true&limit=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const product = pm.response.json().data[0];",
                  "pm.collectionVariables.set('productId', product.id);",
                  "pm.collectionVariables.set('price', product.price);"
                ]
              }
            }
          ]
        },
        {
          "name": "Place an order",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "const order = pm.response.json();",
                  "pm.collectionVariables.set('orderId', order.id);",
                  "",
                  "pm.test('Total is price x quantity', () => {",
                  "  const price = pm.collectionVariables.get('price');",
                  "  pm.expect(order.total).to.eql(price * 2);",
                  "});",
                  "",
                  "pm.test('New order is PLACED', () => pm.expect(order.status).to.eql('PLACED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Same order comes back', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel the order (clean up)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Order is CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "06 Data-driven: create users",
      "item": [
        {
          "name": "Create a user from the data row",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{emailToSend}}\",\n  \"role\": \"{{role}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This request needs a data file (users.csv). Without one, skip it.",
                  "if (!pm.iterationData.has('case')) {",
                  "  pm.execution.skipRequest();",
                  "}",
                  "",
                  "// \"{unique}\" in the email becomes a new number on every run",
                  "const email = String(pm.iterationData.get('email'));",
                  "pm.variables.set('emailToSend', email.replace('{unique}', Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const row = pm.iterationData;",
                  "const expected = Number(row.get('expectedStatus'));",
                  "",
                  "pm.test(`${row.get('case')}: status ${expected}`, () => {",
                  "  pm.response.to.have.status(expected);",
                  "});",
                  "",
                  "if (row.get('expectedCode')) {",
                  "  pm.test(`${row.get('case')}: error ${row.get('expectedCode')}`, () => {",
                  "    pm.expect(pm.response.json().error.code).to.eql(row.get('expectedCode'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07 Security checks",
      "item": [
        {
          "name": "Log in as tester",
          "request": {
            "method": "POST",
            "header": [],
