{
  "info": {
    "name": "REST API Testing with Postman (Essentials)",
    "description": "Every request in the Essentials guide. Select the environment \"Practice API - Local\" before you send.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Getting started",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": []
        },
        {
          "name": "List testers, 2 per page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users?role=tester&limit=2"
          },
          "event": []
        },
        {
          "name": "Get one user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/1"
          },
          "event": []
        },
        {
          "name": "A user that does not exist",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/999"
          },
          "event": []
