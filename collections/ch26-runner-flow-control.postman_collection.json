{
  "info": {
    "_postman_id": "6ecf302f-0b0f-56df-8d8b-6c5bbfef73b8",
    "name": "Ch26 Collection Runner: Flow Control",
    "description": "Chapter 26 of *API Testing with Postman: The Complete Course*.\n\nShows how scripts change the run order: `pm.execution.setNextRequest()` stops the run, loops a request and jumps by name or ID; `pm.execution.skipRequest()` skips requests. Flow control works only in the Collection Runner, Newman and the Postman CLI, not with **Send**.\n\nAdmin requests are skipped unless the variable `runAdminTests` is `true`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) {",
              "  console.log('API is not healthy: stopping the run here.');",
              "  pm.execution.setNextRequest(null);       // null = stop the run",
              "}",
              "// Start of a run: forget state that an earlier run may have left behind.",
              "pm.collectionVariables.unset('loopIndex');",
              "pm.collectionVariables.set('createdIds', '[]');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Stops the whole run if the API is not healthy."
      }
    },
    {
      "name": "Log in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create users from a list",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Which user is this? 1, 2, 3 ... (kept in a collection variable)",
              "const n = Number(pm.collectionVariables.get('loopIndex') || 1);",
              "pm.variables.set('newName', `Runner User ${n}`);",
              "pm.variables.set('newEmail', `runner${n}.${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const n = Number(pm.collectionVariables.get('loopIndex') || 1);",
              "pm.test(`User ${n} is created`, () => pm.response.to.have.status(201));",
              "",
              "const ids = JSON.parse(pm.collectionVariables.get('createdIds'));",
              "ids.push(pm.response.json().id);",
              "pm.collectionVariables.set('createdIds', JSON.stringify(ids));",
              "",
              "if (n < 3) {",
              "  pm.collectionVariables.set('loopIndex', n + 1);",
              "  pm.execution.setNextRequest('Create users from a list');  // run me again",
              "} else {",
              "  pm.collectionVariables.unset('loopIndex');  // done: go on to the next one",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "description": "Runs 3 times in a row: the post-response script sends the run back to this request.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{newName}}\",\n  \"email\": \"{{newEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin: log in",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Admin requests run only when the variable runAdminTests is \"true\".",
              "if (pm.variables.get('runAdminTests') !== 'true') {",
              "  console.log('Skipped: set runAdminTests=true to include admin requests.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Skipped unless runAdminTests is true.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin: create a product",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Admin requests run only when the variable runAdminTests is \"true\".",
              "if (pm.variables.get('runAdminTests') !== 'true') {",
              "  console.log('Skipped: set runAdminTests=true to include admin requests.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('productId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Skipped unless runAdminTests is true.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Runner Test Product\",\n  \"category\": \"home\",\n  \"price\": 99,\n  \"stock\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Admin: delete the product",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Admin requests run only when the variable runAdminTests is \"true\".",
              "if (pm.variables.get('runAdminTests') !== 'true') {",
              "  console.log('Skipped: set runAdminTests=true to include admin requests.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Skipped unless runAdminTests is true.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Check the new users exist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ids = JSON.parse(pm.collectionVariables.get('createdIds'));",
              "const found = pm.response.json().data.map(u => u.id);",
              "pm.test('All 3 new users are in the list', () => {",
              "  pm.expect(ids).to.have.lengthOf(3);",
              "  ids.forEach(id => pm.expect(found).to.include(id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users?search=Runner User&limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "search",
              "value": "Runner User"
            },
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "Delete the users (loop)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Take the next id to delete from the list.",
              "const ids = JSON.parse(pm.collectionVariables.get('createdIds'));",
              "pm.variables.set('deleteId', ids[0]);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(`User ${pm.variables.get('deleteId')} is deleted`, () => {",
              "  pm.response.to.have.status(204);",
              "});",
              "const ids = JSON.parse(pm.collectionVariables.get('createdIds')).slice(1);",
              "pm.collectionVariables.set('createdIds', JSON.stringify(ids));",
              "if (ids.length > 0) {",
              "  pm.execution.setNextRequest(pm.info.requestId);  // same request, by ID",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{deleteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{deleteId}}"
          ]
        },
        "description": "Repeats itself until every created user is deleted."
      }
    },
    {
      "name": "Verify the users are gone",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('No \"Runner User\" is left', () => {",
              "  pm.expect(pm.response.json().total).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users?search=Runner User",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "search",
              "value": "Runner User"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "createdIds",
      "value": "[]"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ]
}
