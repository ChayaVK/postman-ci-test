{
  "info": {
    "name": "Ch 12 Auth in Postman (hands-on)",
    "description": "Every request you send in Chapter 12, in the order of the chapter. Select the environment \"Practice API - Local\" first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 POST /oauth/token (client secret in the body)",
      "item": [
        {
          "name": "POST /oauth/token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/oauth/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "postman-client"
                },
                {
                  "key": "client_secret",
                  "value": "postman-secret"
                },
                {
                  "key": "scope",
                  "value": "reports:read"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "02 GET /oauth/authorize (the login page)",
      "item": [
        {
          "name": "GET /oauth/authorize?response_type=code&client_id=postman-client&redirect_uri=https%3A%2F%2Foauth.pstmn.io%2Fv1%2Fcallback&scope=orders%3Aread&state=ch12-state",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/oauth/authorize?response_type=code&client_id=postman-client&redirect_uri=https%3A%2F%2Foauth.pstmn.io%2Fv1%2Fcallback&scope=orders%3Aread&state=ch12-state"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "03 POST /oauth/authorize (Allow)",
      "item": [
        {
          "name": "POST /oauth/authorize",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/oauth/authorize",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "redirect_uri",
                  "value": "https://oauth.pstmn.io/v1/callback"
                },
                {
                  "key": "password",
                  "value": "Test@123"
                },
                {
                  "key": "client_id",
                  "value": "postman-client"
                },
                {
                  "key": "scope",
                  "value": "orders:read"
                },
                {
                  "key": "state",
                  "value": "ch12-state"
                },
                {
                  "key": "username",
                  "value": "tester"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// keep the one-time code from the Location header",
                  "const loc = pm.response.headers.get('Location');",
                  "pm.collectionVariables.set('code', loc.match(/code=([^&]+)/)[1]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "04 POST /oauth/token (exchange the code)",
      "item": [
        {
          "name": "POST /oauth/token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/oauth/token",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "postman-client",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "postman-secret",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "redirect_uri",
                  "value": "https://oauth.pstmn.io/v1/callback"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "{{code}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('access', pm.response.json().access_token);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('refresh', pm.response.json().refresh_token);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "05 GET /api/auth/me",
      "item": [
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
