                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "postman-secret",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refresh}}"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "POST /oauth/token (2)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/oauth/token",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "postman-client",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "postman-secret",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refresh}}"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "07 POST /oauth/token with the used code",
      "item": [
        {
          "name": "POST /oauth/token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/oauth/token",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "postman-client",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "postman-secret",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "redirect_uri",
                  "value": "https://oauth.pstmn.io/v1/callback"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "{{code}}"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
    {
      "name": "08 GET /oauth/authorize with an unregistered redirect_uri",
      "item": [
        {
          "name": "GET /oauth/authorize?response_type=code&client_id=postman-client&redirect_uri=https%3A%2F%2Fevil.example.com%2Fcb",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/oauth/authorize?response_type=code&client_id=postman-client&redirect_uri=https%3A%2F%2Fevil.example.com%2Fcb"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    }
  ],
  "variable": [
    {
