{
  "info": {
    "_postman_id": "33fe7b20-8295-5308-8c0c-d508c7fe7844",
    "name": "Ch 00 - Setup Check",
    "description": "Run these three requests after you start the practice API to check that Postman, the environment and the API work together. Select the environment \"Practice API - Local\" first (top right).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Is the practice API running? Expect 200 and status UP."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('API says it is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Welcome and accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        },
        "description": "The home endpoint lists the test accounts, the API key and the OAuth client."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Lists 3 test accounts', () => pm.expect(pm.response.json().accounts).to.have.lengthOf(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reset all data",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reset",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reset"
          ]
        },
        "description": "Puts every user, product and order back to the starting state. Use it whenever your experiments have changed the data."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
