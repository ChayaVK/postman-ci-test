{
  "info": {
    "name": "Appendix B Headers (hands-on)",
    "description": "Every request you send in Chapter 41, in the order of the chapter. Select the environment \"Practice API - Local\" first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 GET /api/users",
      "item": [
        {
          "name": "GET /api/users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Encoding",
                "value": "gzip"
              }
            ],
            "url": "{{baseUrl}}/api/users"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ]
}
