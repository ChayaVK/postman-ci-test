    {
      "name": "Cookies and sessions",
      "description": "Postman keeps the cookie the server sets and sends it back.",
      "item": [
        {
          "name": "Log in (sets a cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/session/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "session",
                "login"
              ]
            },
            "description": "Look at the Set-Cookie header.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
