    {
      "name": "12 POST /api/auth/login and decode the token",
      "item": [
        {
          "name": "POST /api/auth/login and decode the token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"tester\", \"password\": \"Test@123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Decode the token's header and payload (they are Base64URL text, not encrypted)",
                  "const fromBase64 = require('atob');",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set('token', token);",
                  "const [header, payload] = token.split('.').slice(0, 2)",
                  "  .map((part) => JSON.parse(fromBase64(part.replace(/-/g, '+').replace(/_/g, '/'))));",
                  "console.log('HEADER  ' + JSON.stringify(header));",
                  "console.log('PAYLOAD ' + JSON.stringify(payload, null, 2));",
                  "console.log('expires ' + new Date(payload.exp * 1000).toISOString());"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
