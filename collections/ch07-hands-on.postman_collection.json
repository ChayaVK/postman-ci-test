        },
        {
          "name": "DELETE /api/admin/users/8 with an edited token",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{edited}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/8"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Change the role inside the payload; the signature stays the old one",
                  "const fromBase64 = require('atob'), toBase64 = require('btoa');",
                  "const [h, p, sig] = pm.collectionVariables.get('token').split('.');",
                  "const claims = JSON.parse(fromBase64(p.replace(/-/g, '+').replace(/_/g, '/')));",
                  "claims.role = 'admin';",
                  "const p2 = toBase64(JSON.stringify(claims)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('edited', [h, p2, sig].join('.'));",
                  "console.log('edited payload ' + JSON.stringify(claims));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
