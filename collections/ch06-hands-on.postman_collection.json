    {
      "name": "14 GET /openapi.json (list operations)",
      "item": [
        {
          "name": "GET /openapi.json (list operations)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.json"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Print every operation and its documented status codes to the Console",
                  "const spec = pm.response.json();",
                  "for (const [path, ops] of Object.entries(spec.paths))",
                  "  for (const m of Object.keys(ops)) if (m !== 'parameters')",
                  "    console.log(m.toUpperCase().padEnd(7) + path.padEnd(19) + Object.keys(ops[m].responses).join(' '));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
