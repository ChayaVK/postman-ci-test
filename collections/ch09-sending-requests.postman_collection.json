{
	"info": {
		"_postman_id": "05c0b956-9d6e-57dd-ba28-be83d5ca4feb",
		"name": "Ch 09 - Sending Requests",
		"description": "# Chapter 9: sending requests\n\nEvery HTTP method, query and path parameters, headers, every body type and one request setting, all against the practice API.\n\nBefore you send: start the practice API (`node server.js` in the practice-api folder) and select the environment **Practice API - Local** in the environment selector at the top right.\n\nRun the folder **1. Methods** from top to bottom: its first request resets the practice data, so the user you create always gets id 9.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Methods",
			"description": "Create, read, replace, update and delete one user, then HEAD and OPTIONS. Send the requests in order.",
			"item": [
				{
					"name": "Reset practice data",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/reset",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"reset"
							]
						},
						"description": "Puts all practice data back to the starting state."
					},
					"response": []
				},
				{
					"name": "Create a user (POST)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Sara Khan\",\n  \"email\": \"sara@example.com\",\n  \"role\": \"tester\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Expect `201 Created` and a `Location` header."
					},
					"response": []
				},
				{
					"name": "Get the new user (GET)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "9"
								}
							]
						},
						"description": "Reads the user created above."
					},
					"response": []
				},
				{
					"name": "Replace the user (PUT)",
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "9"
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Sara Khan\",\n  \"email\": \"sara.khan@example.com\",\n  \"role\": \"developer\",\n  \"active\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "PUT replaces the whole record, so the body has every field."
					},
					"response": []
				},
				{
					"name": "Change one field (PATCH)",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "9"
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"active\": false\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "PATCH sends only the fields that change."
					},
					"response": []
				},
				{
					"name": "Delete the user (DELETE)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "9"
								}
							]
						},
						"description": "Expect `204 No Content`."
					},
					"response": []
				},
				{
					"name": "Get the deleted user (404)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "9"
								}
							]
						},
						"description": "After the delete, the same GET returns `404 Not Found`."
					},
					"response": []
				},
				{
					"name": "Headers only (HEAD)",
					"request": {
						"method": "HEAD",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"1"
							]
						},
						"description": "Same headers as GET, no body."
					},
					"response": []
				},
				{
					"name": "Allowed methods (OPTIONS)",
					"request": {
						"method": "OPTIONS",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "Read the `Allow` response header."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Parameters",
			"description": "Query parameters and path variables.",
			"item": [
				{
					"name": "Filter, sort and limit (query params)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users?role=tester&sort=-createdAt&limit=2",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users"
							],
							"query": [
								{
									"key": "role",
									"value": "tester"
								},
								{
									"key": "sort",
									"value": "-createdAt"
								},
								{
									"key": "limit",
									"value": "2"
								},
								{
									"key": "active",
									"value": "false",
									"disabled": true
								}
							]
						},
						"description": "Testers, newest first, two per page. The `active` row is disabled (unchecked), so it is not sent."
					},
					"response": []
				},
				{
					"name": "Search with a space (URL encoding)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users?search=Asha Rao",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users"
							],
							"query": [
								{
									"key": "search",
									"value": "Asha Rao"
								}
							]
						},
						"description": "Postman encodes the space in the URL for you."
					},
					"response": []
				},
				{
					"name": "One product (path variable)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/products/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "2"
								}
							]
						},
						"description": "Change the value of `id` in the Path Variables table."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Headers",
			"description": "Headers you add yourself, and the ones Postman adds for you.",
			"item": [
				{
					"name": "Product as XML (Accept header)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/xml",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/products/2",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								"2"
							]
						},
						"description": "Ask for XML instead of JSON."
					},
					"response": []
				},
				{
					"name": "A format the API cannot give (406)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "text/csv",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/products/2",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								"2"
							]
						},
						"description": "Expect `406 Not Acceptable`."
					},
					"response": []
				},
				{
					"name": "Send your own request id",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Request-Id",
								"value": "ch09-demo-001",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/users/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"1"
							]
						},
						"description": "The response header `X-Request-Id` echoes the value you send."
					},
					"response": []
				},
				{
					"name": "See every header Postman sent (echo)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/echo",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"echo"
							]
						},
						"description": "`/api/echo` returns exactly what the server received."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Body types",
			"description": "One request for each body type in the Body tab.",
			"item": [
				{
					"name": "raw JSON sent as Text (415)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Text Body\",\n  \"email\": \"text.body@example.com\"\n}",
							"options": {
								"raw": {
									"language": "text"
								}
							}
						},
						"description": "The body is JSON, but the raw type is **Text**, so Postman sends `Content-Type: text/plain` and the API answers `415 Unsupported Media Type`."
					},
					"response": []
				},
				{
					"name": "Broken JSON (400)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Broken Json\",\n  \"email\": \"broken@example.com\",\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "A trailing comma makes the JSON invalid."
					},
					"response": []
				},
				{
					"name": "x-www-form-urlencoded",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/echo",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"echo"
							]
						},
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "tester",
									"type": "text"
								},
								{
									"key": "password",
									"value": "Test@123",
									"type": "text"
								}
							]
						},
						"description": "Key-value pairs encoded like a query string."
					},
					"response": []
				},
				{
					"name": "form-data with a file (upload)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/files",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"files"
							]
						},
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "files/notes.txt"
								},
								{
									"key": "description",
									"value": "Course notes",
									"type": "text"
								}
							]
						},
						"description": "Uploads `files/notes.txt`. After importing, select the file again in the Body tab (the key `file` must be of type File)."
					},
					"response": []
				},
				{
					"name": "binary file",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/plain",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/echo",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"echo"
							]
						},
						"body": {
							"mode": "file",
							"file": {
								"src": "files/notes.txt"
							}
						},
						"description": "Sends the raw bytes of `files/notes.txt`. Postman does not set a Content-Type for binary, so the request sets one in the Headers tab."
					},
					"response": []
				},
				{
					"name": "Download a file",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/files/sample",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"files",
								"sample"
							]
						},
						"description": "A CSV file with `Content-Disposition: attachment`. Use **Send and Download** to save it."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Request settings",
			"description": "The Settings tab of a request.",
			"item": [
				{
					"name": "Redirect followed (default)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/old-users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"old-users"
							]
						},
						"description": "Postman follows the 301 and shows the final response from `/api/users`."
					},
					"response": []
				},
				{
					"name": "Redirect not followed",
					"protocolProfileBehavior": {
						"followRedirects": false
					},
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/old-users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"old-users"
							]
						},
						"description": "Settings: **Automatically follow redirects** is off, so you see the 301 itself."
					},
					"response": []
				}
			]
		}
	]
}
