							],
							"path": [
								"api",
								"session",
								"logout"
							]
						},
						"description": "The server deletes the session."
					},
					"response": []
				},
				{
					"name": "Session me after logout (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/session/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
