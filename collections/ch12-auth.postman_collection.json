{
	"info": {
		"_postman_id": "5ece9475-60a7-53d2-ac30-5f75fc954c0e",
		"name": "Ch 12 - Auth in Postman",
		"description": "# Chapter 12: auth in Postman\n\nAPI key, Basic, Bearer, cookies and OAuth 2.0 against the practice API.\n\nBefore you send: start the practice API (`node server.js` in the practice-api folder) and select the environment **Practice API - Local** in the environment selector at the top right.\n\nThe collection itself uses **No Auth**; each folder sets its own auth and its requests inherit it. Requests that end in (401) override it on purpose.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. API key",
			"description": "Folder auth: API Key, key `x-api-key`, value `{{apiKey}}`, added to the header.",
			"item": [
				{
					"name": "Sales report (key inherited from folder)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/reports/sales",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"reports",
								"sales"
							]
						},
						"description": "Inherit auth from parent."
					},
					"response": []
				},
				{
					"name": "Sales report (key in query params)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/reports/sales",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"reports",
								"sales"
							]
						},
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "key",
									"value": "api_key",
									"type": "string"
								},
								{
									"key": "value",
									"value": "{{apiKey}}",
									"type": "string"
								},
								{
									"key": "in",
									"value": "query",
									"type": "string"
								}
							]
						},
						"description": "Same key sent as the query parameter `api_key`."
					},
					"response": []
				},
				{
					"name": "Sales report with no key (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/reports/sales",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"reports",
								"sales"
							]
						},
						"auth": {
							"type": "noauth"
						},
						"description": "No Auth."
					},
					"response": []
				},
				{
					"name": "Sales report with a wrong key (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/reports/sales",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"reports",
								"sales"
							]
						},
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "key",
									"value": "x-api-key",
									"type": "string"
								},
								{
									"key": "value",
									"value": "wrong-key",
									"type": "string"
								},
								{
									"key": "in",
									"value": "header",
									"type": "string"
								}
							]
						},
						"description": "A key the API does not know."
					},
					"response": []
				}
			],
			"auth": {
				"type": "apikey",
				"apikey": [
					{
						"key": "key",
						"value": "x-api-key",
						"type": "string"
					},
					{
						"key": "value",
						"value": "{{apiKey}}",
						"type": "string"
					},
					{
						"key": "in",
						"value": "header",
						"type": "string"
					}
				]
			}
		},
		{
			"name": "2. Basic auth",
			"description": "Folder auth: Basic Auth with `{{username}}` and `{{password}}`.",
			"item": [
				{
					"name": "Profile with Basic auth",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/basic/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"basic",
								"profile"
							]
						},
						"description": "Inherit auth from parent."
					},
					"response": []
				},
				{
					"name": "What Basic auth sends (echo)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/echo",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"echo"
							]
						},
						"description": "Shows the Authorization header Postman built."
					},
					"response": []
				},
				{
					"name": "Profile with a wrong password (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/basic/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"basic",
								"profile"
							]
						},
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{username}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "wrong-password",
									"type": "string"
								}
							]
						},
						"description": "Wrong password on purpose."
					},
					"response": []
				}
			],
			"auth": {
				"type": "basic",
				"basic": [
					{
						"key": "username",
						"value": "{{username}}",
						"type": "string"
					},
					{
						"key": "password",
						"value": "{{password}}",
						"type": "string"
					}
				]
			}
		},
		{
			"name": "3. Bearer token",
			"description": "Folder auth: Bearer Token `{{token}}`. Send **Log in and save the token** first.",
			"item": [
				{
					"name": "Log in and save the token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Read the JSON body of the login response",
									"const body = pm.response.json();",
									"// Store the token in the collection variable \"token\"",
									"pm.collectionVariables.set('token', body.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						},
						"description": "The post-response script saves the token in the collection variable `token`."
					},
					"response": []
				},
				{
					"name": "Who am I",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Inherit auth from parent."
					},
					"response": []
				},
				{
					"name": "My orders",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"orders"
							]
						},
						"description": "Inherit auth from parent."
					},
					"response": []
				},
				{
					"name": "Who am I without a token (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"auth": {
							"type": "noauth"
						},
						"description": "No Auth."
					},
					"response": []
				},
				{
					"name": "Who am I with a changed token (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}x",
									"type": "string"
								}
							]
						},
						"description": "One extra character at the end breaks the signature."
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{token}}",
						"type": "string"
					}
				]
			}
		},
		{
			"name": "4. Cookies (session login)",
			"description": "No Auth: the session cookie does the work. Postman stores it in the cookie jar and sends it back to localhost automatically.",
			"item": [
				{
					"name": "Session login (sets a cookie)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/session/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"session",
								"login"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Look for Set-Cookie: sid=..."
					},
					"response": []
				},
				{
					"name": "Session me (cookie sent automatically)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/session/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"session",
								"me"
							]
						},
						"description": "No auth configured."
					},
					"response": []
				},
				{
					"name": "Session logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/session/logout",
							"host": [
