						"description": "The session is gone."
					},
					"response": []
				}
			],
			"auth": {
				"type": "noauth"
			}
		},
		{
			"name": "5. OAuth 2.0 client credentials",
			"description": "Machine-to-machine: no user, no browser.",
			"item": [
				{
					"name": "Token request (what Get New Access Token sends)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"pm.collectionVariables.set('oauthToken', body.access_token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/oauth/token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"oauth",
								"token"
							]
						},
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "reports:read",
									"type": "text"
								}
							]
						},
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "postman-client",
									"type": "string"
								},
								{
									"key": "password",
									"value": "postman-secret",
									"type": "string"
								}
							]
						},
						"description": "Client ID and secret go in a Basic Authorization header; the grant goes in the body. The post-response script saves `access_token` as `oauthToken`."
					},
					"response": []
				},
				{
					"name": "Who am I with the OAuth token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"auth": {
							"type": "oauth2",
							"oauth2": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "string"
								},
								{
									"key": "accessTokenUrl",
									"value": "{{baseUrl}}/oauth/token",
									"type": "string"
								},
								{
									"key": "clientId",
									"value": "postman-client",
									"type": "string"
								},
								{
									"key": "clientSecret",
									"value": "postman-secret",
									"type": "string"
								},
								{
									"key": "scope",
									"value": "reports:read",
									"type": "string"
								},
								{
									"key": "client_authentication",
									"value": "header",
									"type": "string"
								},
								{
									"key": "tokenName",
									"value": "Practice API (client credentials)",
									"type": "string"
								},
								{
									"key": "addTokenTo",
									"value": "header",
									"type": "string"
								},
								{
									"key": "headerPrefix",
									"value": "Bearer",
									"type": "string"
								},
								{
									"key": "accessToken",
									"value": "{{oauthToken}}",
									"type": "string"
								}
							]
						},
						"description": "Authorization tab: OAuth 2.0, Grant type Client Credentials. Select **Get New Access Token**, then **Use Token**. (When run by Newman, the token saved by the previous request is used.)"
					},
					"response": []
				},
				{
					"name": "Token request with a wrong secret (401)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/oauth/token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"oauth",
								"token"
							]
						},
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								}
							]
						},
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "postman-client",
									"type": "string"
								},
								{
									"key": "password",
									"value": "wrong-secret",
									"type": "string"
								}
							]
						},
						"description": "Expect `invalid_client`."
					},
					"response": []
				}
			],
			"auth": {
				"type": "noauth"
			}
		},
		{
