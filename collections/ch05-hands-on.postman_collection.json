    {
      "name": "09 POST /api/webhooks",
      "item": [
        {
          "name": "Log in as tester",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"tester\", \"password\": \"Test@123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/webhooks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/webhooks",
            "body": {
              "mode": "raw",
              "raw": "{\"url\":\"http://localhost:3000/webhook-inbox\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        },
        {
          "name": "POST /api/orders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\":4,\"quantity\":1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        },
