  },
  "item": [
    {
      "name": "01 POST /soap/calculator",
      "item": [
        {
          "name": "POST /soap/calculator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://practice-api.local/calculator/Add\""
              }
            ],
            "url": "{{baseUrl}}/soap/calculator",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"\n               xmlns:calc=\"http://practice-api.local/calculator\">\n  <soap:Header/>\n  <soap:Body>\n    <calc:Add>\n      <calc:intA>7</calc:intA>\n      <calc:intB>5</calc:intB>\n    </calc:Add>\n  </soap:Body>\n</soap:Envelope>\n",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableBodyPruning": true
          }
        }
      ]
    },
