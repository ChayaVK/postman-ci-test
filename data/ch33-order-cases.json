[
  {"caseName": "quantity 0 (below minimum)",
   "body": {"productId": 1, "quantity": 0},
   "expectedStatus": 400, "expectedCode": "VALIDATION_FAILED"},
  {"caseName": "quantity 11 (above maximum)",
   "body": {"productId": 1, "quantity": 11},
   "expectedStatus": 400, "expectedCode": "VALIDATION_FAILED"},
  {"caseName": "quantity as a string",
   "body": {"productId": 1, "quantity": "2"},
   "expectedStatus": 400, "expectedCode": "VALIDATION_FAILED"},
  {"caseName": "quantity 1.5 (not whole)",
   "body": {"productId": 1, "quantity": 1.5},
   "expectedStatus": 400, "expectedCode": "VALIDATION_FAILED"},
  {"caseName": "productId missing",
   "body": {"quantity": 1},
   "expectedStatus": 400, "expectedCode": "VALIDATION_FAILED"},
  {"caseName": "productId null",
   "body": {"productId": null, "quantity": 1},
   "expectedStatus": 400, "expectedCode": "VALIDATION_FAILED"},
  {"caseName": "product does not exist",
   "body": {"productId": 999, "quantity": 1},
   "expectedStatus": 422, "expectedCode": "PRODUCT_NOT_FOUND"},
  {"caseName": "product out of stock",
   "body": {"productId": 3, "quantity": 1},
   "expectedStatus": 409, "expectedCode": "OUT_OF_STOCK"}
]
