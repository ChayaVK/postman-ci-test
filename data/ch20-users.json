[
  { "case": "Role is optional (defaults to tester)",
    "body": { "name": "No Role Given", "email": "no.role@example.com" },
    "expectedStatus": 201, "expect": { "role": "tester", "active": true } },
  { "case": "active=false is stored as false",
    "body": { "name": "Inactive User", "email": "inactive@example.com",
              "active": false },
    "expectedStatus": 201, "expect": { "active": false } },
  { "case": "Spaces around the name are trimmed",
    "body": { "name": "  Padded Name  ", "email": "padded@example.com" },
    "expectedStatus": 201, "expect": { "name": "Padded Name" } },
  { "case": "Name of 50 characters is accepted",
    "body": { "email": "max.name@example.com",
              "name": "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN" },
    "expectedStatus": 201 },
  { "case": "Name of 51 characters is rejected",
    "body": { "email": "long.name@example.com",
              "name": "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN" },
    "expectedStatus": 400, "expectedField": "name" },
  { "case": "active as the string \"true\" is rejected",
    "body": { "name": "String Flag", "email": "flag@example.com",
              "active": "true" },
    "expectedStatus": 400, "expectedField": "active" },
  { "case": "Missing name is rejected",
    "body": { "email": "no.name@example.com" },
    "expectedStatus": 400, "expectedField": "name" }
]
